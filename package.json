{
  "name": "parus-desktop",
  "version": "1.0.0",
  "description": "Parus — настольный клиент мессенджера",
  "author": "Parus",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never && electron-builder --win nsis --ia32 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.parus.messenger",
    "productName": "Parus",
    "copyright": "Parus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "toast-preload.js",
      "toast.html",
      "splash.html",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1049",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parus",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Parus-Setup-${arch}.${ext}"
    }
  }
}
